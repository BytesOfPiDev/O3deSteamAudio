{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder SteamAudio/Assets": {
                    "watch": "@GEMROOT:SteamAudio@/Assets",
                    "recursive": 1,
                    "order": 101
                },
                "ScanFolder SteamAudio/Registry": {
                    "watch": "@GEMROOT:SteamAudio@/Registry",
                    "recursive": 1,
                    "order": 102
                },
                "RC sabank": {
                    "glob": "*.sabank",
                    "params": "copy"
                },
                "RC sasoundsource": {
                    "glob": "*.sasoundsource",
                    "params": "copy",
                    "productAssetType": "{CD038A39-CF2C-4A69-9877-DC7EFE284F25}"
                }
            }
        }
    }
}
